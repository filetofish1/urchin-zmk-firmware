#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    combos {
        compatible = "zmk,combos";

        minus {
            bindings = <&kp MINUS>;
            key-positions = <6 7>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <18>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <7 8>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <18>;
        };

        exlam {
            bindings = <&kp EXCLAMATION>;
            key-positions = <11 1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        at {
            bindings = <&kp AT_SIGN>;
            key-positions = <2 12>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        hash {
            bindings = <&kp HASH>;
            key-positions = <3 13>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <4 14>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <5 15>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <6 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <7 17>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        asterix {
            bindings = <&kp ASTERISK>;
            key-positions = <8 18>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        parentheses_1 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <1 2>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <18>;
        };

        parentheses_2 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <2 3>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <18>;
        };

        bracket_1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <6 16>;
            layers = <1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        bracket_2 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 17>;
            layers = <1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        brace_1 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 26>;
            layers = <1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        brace_2 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <17 27>;
            layers = <1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <20 21>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <20 22>;
            require-prior-idle-ms = <50>;
            layers = <0>;
            timeout-ms = <30>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <21 22>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <22 23>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <28 27>;
            require-prior-idle-ms = <50>;
            layers = <0>;
            timeout-ms = <18>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <26 27>;
            timeout-ms = <18>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        page_up {
            bindings = <&kp PAGE_UP>;
            key-positions = <12 2>;
            layers = <1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        page_down {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <12 22>;
            layers = <1>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
        };

        mute {
            bindings = <&kp C_MUTE>;
            key-positions = <1 3>;
            timeout-ms = <18>;
            require-prior-idle-ms = <50>;
            layers = <1>;
        };

        to_numpad {
            bindings = <&to 1>;
            key-positions = <10 20>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        from_numpad {
            bindings = <&to 0>;
            key-positions = <10 20>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <1>;
        };

        to_system {
            bindings = <&to 2>;
            key-positions = <19 29>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        from_system {
            bindings = <&to 0>;
            key-positions = <29 19>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <2>;
        };

        keyboard_reset {
            bindings = <&bootloader>;
            key-positions = <0 1 2 3 6 7 8 9>;
            timeout-ms = <200>;
            require-prior-idle-ms = <200>;
            layers = <2>;
        };

        bootloader_1 {
            bindings = <&mo 3>;
            key-positions = <30 31>;
            layers = <0>;
            require-prior-idle-ms = <1000>;
        };

        bootloader_2 {
            bindings = <&mo 3>;
            key-positions = <32 33>;
            layers = <0>;
            require-prior-idle-ms = <1000>;
        };
    };

    macros {
        bracket_soft: bracket_soft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "BRACKET_SOFT";
        };
    };

    behaviors {
        hrm_L: hrm_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33 30 31>;
        };

        hrm_R: hrm_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33>;
        };

        hrm_ctrl_L: hrm_ctrl_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_CTRL_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 32 31 30>;
        };

        hrm_ctrl_R: hrm_ctrl_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_CTRL_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33>;
        };

        z_ctrl: z_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "Z_CTRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <2 3 4 11 12 13 14 21 22 23 24 1>;
        };

        tab_layer1: tab_layer1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TAB_LAYER1";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
            hold-trigger-key-positions = <0 10 20 11 12 13 2 33 6 7 8 16 17 18 26 27 28>;
            hold-trigger-on-release;
        };

        bckspce_layer2: bckspce_layer2 {
            compatible = "zmk,behavior-hold-tap";
            label = "BCKSPCE_LAYER2";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 10 11 12 13 20 21 22 23 2 16 17 18 19>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            label = "default";
            bindings = <
&kp Q                   &kp W              &kp E              &kp R                       &kp T              &kp Y                        &kp U                        &kp I               &kp O               &kp P
&hrm_L LEFT_SHIFT A     &hrm_L LEFT_GUI S  &hrm_L LEFT_ALT D  &hrm_ctrl_L LEFT_CONTROL F  &kp G              &kp H                        &hrm_ctrl_R RIGHT_CONTROL J  &hrm_R RIGHT_ALT K  &hrm_R RIGHT_GUI L  &hrm_R RIGHT_SHIFT SEMICOLON
&z_ctrl LEFT_CONTROL Z  &kp X              &kp C              &kp V                       &kp B              &kp N                        &kp M                        &kp COMMA           &kp DOT             &kp SLASH
                                                              &kp LEFT_SHIFT              &tab_layer1 1 TAB  &bckspce_layer2 2 BACKSPACE  &kp SPACE
            >;
        };

        arrow_numpad {
            bindings = <
&kp ESC                           &kp C_VOLUME_DOWN  &kp UP    &kp C_VOL_UP  &kp SLASH   &kp ASTERISK  &kp N7                        &kp N8               &kp N9               &kp ENTER
&kp DEL                           &kp LEFT           &kp DOWN  &kp RIGHT     &kp MINUS   &kp PLUS      &hrm_ctrl_R RIGHT_CONTROL N4  &hrm_R RIGHT_ALT N5  &hrm_R RIGHT_GUI N6  &hrm_R RIGHT_SHIFT SQT
&z_ctrl LEFT_CONTROL PRINTSCREEN  &kp C_PREV         &kp C_PP  &kp C_NEXT    &kp PERIOD  &kp EQUAL     &kp N1                        &kp N2               &kp N3               &kp DOUBLE_QUOTES
                                                               &trans        &trans      &trans        &kp N0
            >;

            label = "numpad";
        };

        function_system {
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &kp CLCK   &bracket_soft  &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2  &bt BT_SEL 3
&kp F5  &kp F6   &kp F7   &kp F8   &kp GRAVE  &kp BSLH       &kp RCTRL     &kp RALT         &kp RGUI      &kp RSHFT
&kp F9  &kp F10  &kp F11  &kp F12  &kp TILDE  &kp PIPE       &bt BT_CLR    &rgb_ug RGB_TOG  &out OUT_TOG  &bt BT_CLR_ALL
                          &trans   &trans     &trans         &trans
            >;

            label = "system";
        };

        bootloader {
            bindings = <
&trans  &trans  &trans  &trans  &bootloader  &bootloader  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans       &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans       &trans  &trans  &trans  &trans
                        &trans  &trans       &trans       &trans
            >;

            label = "bootloader";
        };
    };
};
