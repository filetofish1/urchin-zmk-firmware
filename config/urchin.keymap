#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    combos {
        compatible = "zmk,combos";

        minus {
            bindings = <&kp MINUS>;
            key-positions = <6 7>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <18>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <7 8>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <18>;
        };

        exlam {
            bindings = <&kp EXCLAMATION>;
            key-positions = <0 10>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        at {
            bindings = <&kp AT_SIGN>;
            key-positions = <1 11>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        hash {
            bindings = <&kp HASH>;
            key-positions = <2 12>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <3 13>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <6 16>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <7 17>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <18 8>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        asterix {
            bindings = <&kp ASTERISK>;
            key-positions = <9 19>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        parentheses_1 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <1 2>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <18>;
        };

        parentheses_2 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <2 3>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <18>;
        };

        bracket_1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <6 16>;
            layers = <1>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
        };

        bracket_2 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 17>;
            layers = <1>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
        };

        brace_1 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 26>;
            layers = <1>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
        };

        brace_2 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <17 27>;
            layers = <1>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
        };

        undo {
            bindings = <&kp LC(Z)>;
            key-positions = <20 21>;
            layers = <0>;
            require-prior-idle-ms = <50>;
            timeout-ms = <30>;
        };

        cut {
            
